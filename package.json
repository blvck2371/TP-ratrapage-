{
  "name": "api-docker-mongodb-influxdb",
  "version": "1.0.0",
  "description": "API Node.js Dockerisée avec MongoDB, InfluxDB, Zod et Mongoose",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "docker:dev": "docker-compose up --build",
    "docker:down": "docker-compose down -v"
  },
  "keywords": [
    "api",
    "docker",
    "mongodb",
    "influxdb",
    "nodejs",
    "typescript",
    "zod",
    "mongoose"
  ],
  "author": "LINDOU NGAPOUT",
  "license": "MIT",
  "dependencies": {
    "@influxdata/influxdb-client": "^1.33.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "mongoose": "^8.2.0",
    "morgan": "^1.10.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.19",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}


